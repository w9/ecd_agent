# LLM provider settings (smoke test only — not wired into the FastAPI app)
# Use whichever provider you have access to; leave unused keys blank.

# OpenRouter (preferred). Key may also live in .secrets/openrouter_key
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.6-luna

# Anthropic (optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Which provider the smoke test should use: openai | anthropic | openrouter
LLM_PROVIDER=openrouter

# Print chat payloads to stderr and include them on the /chat UI
LLM_DEBUG=false

# Application paths (optional overrides)
DATA_DIR=data
PROTOCOLS_DIR=data/protocols
PROTOCOLS_DB_PATH=data/protocols.db
SITES_CSV_PATH=data/sites.csv
SITES_DB_PATH=data/sites.db
