# LLM provider settings (smoke test only — not wired into the FastAPI app)
# Use whichever provider you have access to; leave unused keys blank.

# OpenAI-compatible (OpenAI, Azure OpenAI, Portkey, local vLLM/Ollama proxy, etc.)
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Anthropic (optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Which provider the smoke test should use: openai | anthropic
LLM_PROVIDER=openai

# Application paths (optional overrides)
DATA_DIR=data
PROTOCOLS_DIR=data/protocols
PROTOCOLS_DB_PATH=data/protocols.db
SITES_CSV_PATH=data/sites.csv
SITES_DB_PATH=data/sites.db
